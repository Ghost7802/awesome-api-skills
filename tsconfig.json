{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["api/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "skills",
    "scripts",
    "snapshots",
    "src",
    "packages",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
